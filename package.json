{
  "name": "yapper-desktop",
  "version": "1.0.2",
  "description": "Unofficial desktop app for yapper.website",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir --publish never && node stamp-icon.js && electron-builder --win --prepackaged dist/win-unpacked --publish never",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "prebuild": "node -e \"const c=require('child_process'),f=require('fs');c.spawnSync('taskkill',['/f','/im','Yapper.exe']);f.rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "2.1.8",
    "resedit": "^2.0.2"
  },
  "build": {
    "appId": "com.unofficial.yapper",
    "productName": "Yapper",
    "icon": "icon.png",
    "files": [
      "main.js",
      "icon.png",
      "yapplusplus.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "TGPG-Studios",
        "repo": "Yapper-App-Unofficial-"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yapper",
      "artifactName": "Yapper-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
